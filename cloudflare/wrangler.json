{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "health-ingest-synthetic",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "r2_buckets": [
    {
      "binding": "DATA",
      "bucket_name": "synthetic-records"
    }
  ],
  "vars": {
    "RELEASE": "unreleased",
    "ACCESS_ISSUER": "",
    "ACCESS_AUD": "",
    "ACCESS_HUMAN_EMAILS": "[]",
    "ACCESS_MACHINES": "[]"
  },
  "triggers": {
    "crons": []
  }
}
